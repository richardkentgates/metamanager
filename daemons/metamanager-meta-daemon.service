[Unit]
Description=Metamanager Metadata Embedding Daemon
Documentation=https://github.com/richardkentgates/metamanager
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/metamanager-meta-daemon.sh
User=www-data
Group=www-data
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
UMask=0077
ReadWritePaths=__WP_CONTENT_DIR__/metamanager-jobs __WP_CONTENT_DIR__/uploads /var/log

# Logging to journald (also appended to log file by the script itself)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metamanager-meta

[Install]
WantedBy=multi-user.target

[Unit]
Description=Metamanager Daemon Self-Updater Check
Documentation=https://github.com/richardkentgates/metamanager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/metamanager-self-updater.sh
User=root
Group=root
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metamanager-self-update

# Security hardening. The updater runs apt-get and restarts services, so it
# needs write access to package and unit directories.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/run /var/log /usr/local/lib/metamanager /etc/systemd/system /var/lib/apt /var/lib/dpkg /var/cache/apt
